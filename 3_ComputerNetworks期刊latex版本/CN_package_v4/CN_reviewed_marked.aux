\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces FedRAS \DIFdelbeginFL  {\color {red}\sout {system architecture and }}\DIFdelendFL  round pipeline. \DIFdelbeginFL  {\color {red}\sout {The edge aggregator estimates client link states, }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {Action Construction (AC) }}\DIFaddendFL  scores every client--rank pair with the delivery hazard \eqref  {eq:hazard} and the saturating capacity \eqref  {eq:cap}\DIFdelbeginFL  {\color {red}\sout {, and }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {; the GridDP assignment (GDP) }}\DIFaddendFL  computes the client--rank assignment \DIFdelbeginFL  {\color {red}\sout {with the exact grid-based dynamic program }}\DIFdelendFL  under the byte budget and the admission cap\DIFdelbeginFL  {\color {red}\sout {(Proposition~\ref {prop:dp}). Admitted clients train on a frozen backbone with LoRA factors sliced to the assigned rank and upload only the trainable factor $B$, at 5.63\,KB per rank column; the shared factor $A$ is never transmitted}}\DIFdelendFL  . Updates arriving within the deadline $\tau $ pass the on-time gate and are \DIFdelbeginFL  {\color {red}\sout {aggregated rank-maskedly }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {merged by Masked Aggregation (MA) }}\DIFaddendFL  while \DIFaddbeginFL  {\color {blue}\uwave {the shared factor }}\DIFaddendFL  $A$ stays frozen\DIFdelbeginFL  {\color {red}\sout {(Proposition~\ref {prop:agg})}}\DIFdelendFL  ; \DIFdelbeginFL  {\color {red}\sout {late or lost updates are discarded, and the }}\DIFdelendFL  observed outcomes update the link-state history. \DIFaddbeginFL  {\color {blue}\uwave {AC, GDP, and MA correspond to Algorithms~\ref {alg:ac}--\ref {alg:ma}; the overall round is Algorithm~\ref {alg:fedras}.}}\DIFaddendFL  }}{50}{}\protected@file@percent }
\newlabel{fig:architecture}{{1}{50}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \DIFdelbeginFL  {\color {red}\sout {Final accuracy across datasets. }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {Real-trainer experiments (}}\DIFaddendFL  CIFAR-10\DIFdelbeginFL  {\color {red}\sout {uses ten }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {, means over }}\DIFaddendFL  seeds\DIFdelbeginFL  {\color {red}\sout {; CIFAR-100 }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {). (a)~At the nominal deadline all rank policies hold the pretrained-backbone accuracy. (b)~Under the 0.1\,s deadline all methods remain stable while full-model updates deliver nothing }}\DIFaddendFL  and \DIFdelbeginFL  {\color {red}\sout {MNIST use five seeds}}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {stay at the backbone}}\DIFaddendFL  . \DIFdelbeginFL  {\color {red}\sout {The parity }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {(c)~FedRAS is link-aware: delivered rank holds the provisioned width at the nominal deadline }}\DIFaddendFL  and \DIFdelbeginFL  {\color {red}\sout {equivalence findings }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {steps down as the deadline tightens, against the fixed heat--cool path (gray dashed) that the annealing baseline follows regardless }}\DIFaddendFL  of \DIFdelbeginFL  {\color {red}\sout {Table}}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {link state. (d)}}\DIFaddendFL  ~\DIFdelbeginFL  {\color {red}\sout {\ref {tab:trainer} are }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {Final accuracy relative to the per-dataset pretrained backbone; the parity is }}\DIFaddendFL  not CIFAR-10-specific \DIFaddbeginFL  {\color {blue}\uwave {(numbers in Table~\ref {tab:extended})}}\DIFaddendFL  .}}{51}{}\protected@file@percent }
\newlabel{fig:trainermain}{{2}{51}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \DIFdelbeginFL  {\color {red}\sout {Real-trainer }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {Delivered-update norm vs.\ rank on }}\DIFaddendFL  CIFAR-10 \DIFdelbeginFL  {\color {red}\sout {test accuracy over 40 federated rounds at the nominal deadline }}\DIFdelendFL  (mean over \DIFdelbeginFL  {\color {red}\sout {ten }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {delivered rounds; five }}\DIFaddendFL  seeds \DIFaddbeginFL  {\color {blue}\uwave {per point, error bars are one standard deviation}}\DIFaddendFL  ). \DIFdelbeginFL  {\color {red}\sout {All }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {The measured growth ($2.5\times $ from }}\DIFaddendFL  rank \DIFdelbeginFL  {\color {red}\sout {policies hold }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {2 to 16, $1.9\times $ from rank 4 to 16) tracks }}\DIFaddendFL  the \DIFdelbeginFL  {\color {red}\sout {pretrained-backbone accuracy}}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {square-root capacity law of \eqref  {eq:cap} ($2.8\times $ and $2.0\times $) rather than linear payload growth ($8\times $ and $4\times $)}}\DIFaddendFL  ; \DIFdelbeginFL  {\color {red}\sout {differences appear in bytes }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {the nominal }}\DIFaddendFL  and \DIFdelbeginFL  {\color {red}\sout {timeliness, not accuracy}}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {stress series coincide}}\DIFaddendFL  .}}{52}{}\protected@file@percent }
\newlabel{fig:normlaw}{{3}{52}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces {\color {blue}\uwave {Sensitivity of the trainer to provisioned adapter width, cohort size, and label heterogeneity on CIFAR-10 with FedRAS (five seeds per variant; the nominal reference column uses ten seeds). Accuracy is flat in $r_{\max }$ and cohort size, with a second-order drop only at $\alpha {=}0.1$; the dominant effect of all three axes is on bytes and delivered updates (red, right axis).}}}}{52}{}\protected@file@percent }
\newlabel{fig:sens}{{4}{52}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces {\color {blue}\uwave {Weak-backbone capacity payoff (one-epoch pretrain, five seeds). (a)~Nominal deadline: the rank--accuracy coupling appears (rank 16 above rank 4 by 2.1 points) and FedRAS coincides with rank 16; the dashed line marks the pretrained backbone. (b)~Stress deadline (0.1\,s): FedRAS lands between the fixed ranks on accuracy while delivering more updates than rank 16 at $20\%$ fewer bytes; annotations give attempted MB per round and mean delivered rank.}}}}{53}{}\protected@file@percent }
\newlabel{fig:weakbb}{{5}{53}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Scheduler simulation utility-state trajectories (mean over five seeds). (a)~Nominal 2.0\,s deadline, where FedRAS matches fixed rank 16. (b)~0.1\,s deadline, where FedRAS downshifting separates from fixed rank 16.}}{53}{}\protected@file@percent }
\newlabel{fig:sim}{{6}{53}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Timely delivery ratio and attempted bytes per method across simulator regimes\DIFaddbeginFL  {\color {blue}\uwave {, including the 1000-client scalability regime }}\DIFaddendFL  (five-seed means, final round). Full-model updates deliver nothing under stress and cannot be admitted at all under the binding budget.}}{54}{}\protected@file@percent }
\newlabel{fig:simreg}{{7}{54}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \DIFdelbeginFL  {\color {red}\sout {Sensitivity }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {Solver study. (a)~Objective loss }}\DIFaddendFL  of the \DIFdelbeginFL  {\color {red}\sout {trainer }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {heuristics relative }}\DIFaddendFL  to \DIFdelbeginFL  {\color {red}\sout {provisioned adapter width, cohort size, and label heterogeneity on CIFAR-10 with FedRAS (five seeds per variant; }}\DIFdelendFL  the \DIFdelbeginFL  {\color {red}\sout {nominal reference column uses ten seeds). Accuracy is flat in $r_{\max }$, cohort size, and $\alpha $ }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {DP }}\DIFaddendFL  across \DIFdelbeginFL  {\color {red}\sout {the tested ranges; their effect is on bytes }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {deadline }}\DIFaddendFL  and \DIFdelbeginFL  {\color {red}\sout {delivered updates }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {budget cells. }}\DIFaddendFL  (\DIFdelbeginFL  {\color {red}\sout {red, right axis}}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {b}}\DIFaddendFL  )\DIFaddbeginFL  {\color {blue}\uwave {~DP runtime scaling with the client population}}\DIFaddendFL  .}}{54}{}\protected@file@percent }
\newlabel{fig:dp}{{8}{54}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Delivery-predictor calibration study (500 clients, 150 round-instances per cell). \DIFdelbeginFL  {\color {red}\sout {The left panel shows }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {Left: }}\DIFaddendFL  reliability at the 0.1\,s deadline\DIFdelbeginFL  {\color {red}\sout {. With }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {; with }}\DIFaddendFL  oracle link state the hazard-form predictor is calibrated by construction, while the power-distorted ($\gamma $) and noisy variants are measurably miscalibrated. \DIFdelbeginFL  {\color {red}\sout {The right panel shows the }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {Right: }}\DIFaddendFL  assignment-objective loss of optimizing against the distorted predictor, evaluated under true probabilities, at most 1\% in every cell.}}{55}{}\protected@file@percent }
