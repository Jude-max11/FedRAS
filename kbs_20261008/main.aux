\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Positioning against federated LoRA and client-selection systems. \checkmark  {} = the property holds in the cited papers' own descriptions; $\times $ = absent or not reported. Delivery-aware means that a scheduling or adaptation decision conditions on per-round network delivery state (rate, deadline, delivery probability) rather than on training progress, device capability, or static profiling alone; the wireless-aware rank line (ROBA, TSFA, adaptive FL) reads channel state but optimizes expected latency or convergence time with delivery assumed once resources are granted, so it is not delivery-aware in this per-payload sense. Real payload means payload is accounted as transmitted bytes rather than a fixed or parameter-count proxy. Real training means model training is executed in the evaluation as reported.}}{4}{table.8}\protected@file@percent }
\newlabel{tab:rwcompare}{{1}{4}{Positioning against federated LoRA and client-selection systems. \checkmark {} = the property holds in the cited papers' own descriptions; $\times $ = absent or not reported. Delivery-aware means that a scheduling or adaptation decision conditions on per-round network delivery state (rate, deadline, delivery probability) rather than on training progress, device capability, or static profiling alone; the wireless-aware rank line (ROBA, TSFA, adaptive FL) reads channel state but optimizes expected latency or convergence time with delivery assumed once resources are granted, so it is not delivery-aware in this per-payload sense. Real payload means payload is accounted as transmitted bytes rather than a fixed or parameter-count proxy. Real training means model training is executed in the evaluation as reported}{table.8}{}}
\newlabel{tab:rwcompare@cref}{{[table][1][]1}{[1][3][]4}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The FedRAS architecture. Action Construction (AC) scores every client--rank pair with the hazard model \cref  {eq:hazard} and the saturating capacity \cref  {eq:cap}; the GridDP assignment (GDP) computes the client--rank assignment under the byte budget and the admission cap. Updates arriving within the deadline $\tau $ pass the on-time gate and are merged by Masked Aggregation (MA) while the shared factor $A$ stays frozen; observed outcomes update the link-state history. AC, GDP, and MA correspond to \cref  {alg:ac,alg:gdp,alg:ma}; the overall round is \cref  {alg:fedras}.}}{4}{figure.11}\protected@file@percent }
\newlabel{fig:architecture}{{1}{4}{The FedRAS architecture. Action Construction (AC) scores every client--rank pair with the hazard model \cref {eq:hazard} and the saturating capacity \cref {eq:cap}; the GridDP assignment (GDP) computes the client--rank assignment under the byte budget and the admission cap. Updates arriving within the deadline $\tau $ pass the on-time gate and are merged by Masked Aggregation (MA) while the shared factor $A$ stays frozen; observed outcomes update the link-state history. AC, GDP, and MA correspond to \cref {alg:ac,alg:gdp,alg:ma}; the overall round is \cref {alg:fedras}}{figure.11}{}}
\newlabel{fig:architecture@cref}{{[figure][1][]1}{[1][3][]4}}
