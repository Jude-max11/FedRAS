\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Delivery-predictor calibration study (500 clients, 150 round-instances per cell). (a)~Reliability at the 0.1\,s deadline; with oracle link state the hazard predictor is calibrated by construction, while the power-distorted ($\gamma $) and noisy variants are measurably miscalibrated. (b)~Assignment-objective loss of optimizing against the distorted predictor, evaluated under true probabilities, at most 1\% on average in every cell; the $\gamma = 0.5$ loss is $<0.001\%$ throughout, labeled explicitly on the log-scaled panel.}}{21}{figure.139}\protected@file@percent }
\@writefile{lof}{\contentsline {subfigure}{\numberline{((a))}{\ignorespaces {reliability at the 0.1\,s deadline}}}{21}{subfigure.14.1}\protected@file@percent }
