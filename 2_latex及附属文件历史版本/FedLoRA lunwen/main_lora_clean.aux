\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Real trainer, non-IID CIFAR-10, nominal deadline (five seeds). Accuracy at round 40; timely ratio and bytes averaged over rounds 30--39 (bytes are the normalized per-round payload summed over the 10 participants); the mean rank is taken over delivered updates; Acc/MB is final accuracy per normalized MB.}}{15}{}\protected@file@percent }
\newlabel{tab:trainer}{{2}{15}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Accuracy parity and rank invariance in the trainer}{15}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Real-trainer CIFAR-10 test accuracy over 40 federated rounds (mean$\pm $std over five seeds). All rank policies hold the pretrained-backbone accuracy; differences appear in bytes and timeliness, not accuracy.}}{16}{}\protected@file@percent }
\newlabel{fig:trainer_acc}{{3}{16}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Deadline stress in the trainer}{16}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Extended stress matrix (five seeds, round-40 accuracy, mean$\pm $std). The loose-deadline and mobility-only scenarios confirm that FedRAS upshifts when pressure is absent; $\alpha {=}0.1$ probes extreme non-IID heterogeneity; the last two columns repeat the 0.25\,s deadline on CIFAR-100 and MNIST. Bold marks the best value at displayed precision, ties included.}}{17}{}\protected@file@percent }
\newlabel{tab:extended}{{3}{17}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Real trainer under deadline stress (non-IID CIFAR-10, five seeds). Accuracy at round 40 (mean$\pm $std); timely ratio, bytes, and rank averaged over rounds 30--39; rank is the mean rank of delivered updates.}}{17}{}\protected@file@percent }
\newlabel{tab:stress}{{4}{17}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Delivered mean rank per round for FedRAS under three deadlines (mean$\pm $std, five seeds), against the fixed annealing schedule of the SA-FedLoRA-style baseline. FedRAS is link-aware, holding high rank when possible and downshifting under pressure.}}{18}{}\protected@file@percent }
\newlabel{fig:rankdyn}{{4}{18}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Real-trainer accuracy trajectories under the 0.25\,s deadline (mean$\pm $std, five seeds). All methods remain stable. FedRAS selects lower ranks on slow links and matches rank-16 delivery at 14\% fewer bytes.}}{18}{}\protected@file@percent }
\newlabel{fig:trainer_dl}{{5}{18}{}{}{}}
