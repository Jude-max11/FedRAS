\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Full scheduling versus fair-cohort in the real trainer (non-IID CIFAR-10, nominal deadline, ten seeds): accuracy at round 40; network metrics averaged over rounds 30--39. Both arms share the candidate set (all 20 clients) and the participation cap $K{=}10$; the DP arm additionally enforces an 8.2\,MB byte budget.}}{22}{}\protected@file@percent }
\newlabel{tab:dpvfair}{{8}{22}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.7}Scheduler behavior at 500-client scale}{22}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Scheduler simulation accuracy trajectories (mean$\pm $std, five seeds). Under the nominal deadline (left) FedRAS matches fixed rank 16. Under the 0.25\,s deadline (right) FedRAS downshifting separates from fixed rank 16 and outperforms random and full updates.}}{23}{}\protected@file@percent }
\newlabel{fig:sim}{{6}{23}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Simulator network view with timely delivery and per-round bytes versus the round deadline (500 clients, five seeds). Full updates collapse on the delivery axis. The annealed schedule and reliability-only policies save bytes only by giving up rank everywhere, regardless of link state.}}{23}{}\protected@file@percent }
\newlabel{fig:simdl}{{7}{23}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Solver study (500 clients, $K{=}25$, 30 instances per cell): optimality gap of heuristics relative to the exact DP, and DP runtime.}}{24}{}\protected@file@percent }
\newlabel{tab:dp}{{9}{24}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.8}Solver optimality and runtime}{24}{}\protected@file@percent }
\newlabel{sec:dp_study}{{6.8}{24}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Solver study. The left panel shows the optimality gap of greedy heuristics versus the exact DP across deadline and budget cells, where per-byte greedy degrades up to 10\% when the budget binds or the deadline is tight. The right panel shows the DP runtime, which grows linearly with the client population from 167\,ms at 100 clients to 1654\,ms at 1000.}}{24}{}\protected@file@percent }
\newlabel{fig:dp}{{8}{24}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Sensitivity of the trainer to the provisioned adapter width, label heterogeneity, and cohort size (CIFAR-10, FedRAS, five seeds; bars are $\pm $1\,std). Accuracy is flat in $r_{\max }$ and $K$ across the tested ranges; their effect is on bytes and delivered updates.}}{25}{}\protected@file@percent }
\newlabel{fig:sens}{{9}{25}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.9}Sensitivity analysis}{25}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Delivery-predictor calibration study (500 clients, 150 round-instances per cell). The left panel shows reliability at the 0.25\,s deadline. With oracle link state the hazard-form predictor is calibrated by construction, while the power-distorted ($\gamma $) and noisy variants are measurably miscalibrated. The right panel shows the assignment-objective loss of optimizing against the distorted predictor, evaluated under true probabilities, at most 1.8\% and only in the tightest cell.}}{26}{}\protected@file@percent }
\newlabel{fig:calib}{{10}{26}{}{}{}}
